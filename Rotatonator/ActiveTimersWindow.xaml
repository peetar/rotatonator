<Window x:Class="Rotatonator.ActiveTimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Raid Respawn &amp; Lockout Timers" 
        Height="480" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#2C2C2C">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="⏱️ Raid Lockout &amp; Respawn Timers" FontWeight="Bold" FontSize="16" Foreground="#FFD700" Margin="0,0,0,4"/>
            <TextBlock Text="Timers are automatically saved to local storage (%APPDATA%\Rotatonator\respawn_timers.json) and survive app restarts. Follow-up Discord alerts (⏰) are automatically posted when the timer expires." 
                       Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Timers List -->
        <ListView x:Name="TimersListView" Grid.Row="1" Background="#222222" Foreground="White" BorderBrush="#444444" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusDisplay}" Width="100"/>
                    <GridViewColumn Header="Target Mob" DisplayMemberBinding="{Binding MobName}" Width="140"/>
                    <GridViewColumn Header="Zone" DisplayMemberBinding="{Binding ZoneName}" Width="130"/>
                    <GridViewColumn Header="Mode" DisplayMemberBinding="{Binding ModeDisplay}" Width="140"/>
                    <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding BaseDurationDisplay}" Width="75"/>
                    <GridViewColumn Header="Remaining" DisplayMemberBinding="{Binding FormattedRemaining}" Width="100"/>
                    <GridViewColumn Header="Ready At (Local)" DisplayMemberBinding="{Binding ExpirationDisplay}" Width="125"/>
                    <GridViewColumn Header="Killed By" DisplayMemberBinding="{Binding KillerDisplay}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button x:Name="ForceExpireButton" Content="⚡ Trigger Discord Alert Now" Background="#2196F3" Click="ForceExpireButton_Click" ToolTip="Immediately posts the follow-up ⏰ alert to Discord and marks this timer complete"/>
                <Button x:Name="DeleteButton" Content="🗑️ Remove Timer" Background="#F44336" Click="DeleteButton_Click"/>
                <Button x:Name="ClearCompletedButton" Content="🧹 Clear Completed" Background="#757575" Click="ClearCompletedButton_Click"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Close" Width="80" Background="#555555" Click="CloseButton_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
