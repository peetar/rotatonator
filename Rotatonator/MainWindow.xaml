<Window x:Class="Rotatonator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rotatonator - EQ Complete Heal Chain Manager" 
        Height="660" Width="650"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#2C2C2C">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="#333333" 
                                BorderBrush="#444444" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="4,4,0,0" 
                                Margin="0,0,4,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#3F3F3F"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#45A049"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Log File Selection -->
                <RowDefinition Height="Auto"/> <!-- 1: TabControl (Chain & Features) -->
                <RowDefinition Height="Auto"/> <!-- 2: Timing Configuration -->
                <RowDefinition Height="Auto"/> <!-- 3: Start/Stop Buttons -->
                <RowDefinition Height="Auto"/> <!-- 4: Status -->
            </Grid.RowDefinitions>

            <!-- Log File Selection -->
            <GroupBox Grid.Row="0" Header="EverQuest Log File" Foreground="White" Margin="0,0,0,10" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBox x:Name="LogFilePathTextBox" IsReadOnly="True" Width="320"/>
                        <TextBlock x:Name="LogMonitorIndicator" Text="●" Foreground="Lime" FontWeight="Bold" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="Log is being monitored"/>
                        <TextBlock x:Name="LogFileSizeTextBlock" Foreground="#AAAAAA" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="BrowseLogButton" Content="Browse..." Grid.Column="1" Click="BrowseLogButton_Click" Height="28" MinWidth="80"/>
                    <Button x:Name="ArchiveLogButton" Content="Archive" Grid.Column="2" Click="ArchiveLogButton_Click" Margin="5,0,0,0" Height="28" MinWidth="80"/>
                </Grid>
            </GroupBox>

            <!-- Main TabControl: Chain Setup vs Features -->
            <TabControl Grid.Row="1" Margin="0,0,0,10">
                <!-- Tab 1: Chain Configuration -->
                <TabItem Header="⛓️ Chain Configuration">
                    <StackPanel Margin="5">
                        <Label Content="Chain Prefix (e.g., 'D&amp;D' or 'CHCHAIN'):"/>
                        <TextBox x:Name="ChainPrefixTextBox" Text="D&amp;D"/>
                        
                        <Label Content="Healer Names (one per line, in rotation order):" Margin="0,8,0,0"/>
                        <TextBox x:Name="ChainHealersTextBox" 
                                 Height="90" 
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Healer1&#x0a;Healer2&#x0a;Healer3&#x0a;Healer4"/>
                        
                        <Button x:Name="ExportChainButton" 
                                Content="Export Chain to Clipboard" 
                                Click="ExportChainButton_Click"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Stretch"/>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ExportCHStringButton" 
                                    Content="Export CH Macro" 
                                    Click="ExportCHStringButton_Click"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="ExportAppendMacroButton"
                                    Content="Export Append Macro"
                                    Click="ExportAppendMacroButton_Click"
                                    Grid.Column="1"
                                    Margin="3,0,0,0"/>
                        </Grid>

                        <CheckBox x:Name="CloudSyncCheckBox" 
                                  Content="Sync chain with web server (push on export, auto-import)" 
                                  IsChecked="False"
                                  Checked="CloudSyncCheckBox_Changed"
                                  Unchecked="CloudSyncCheckBox_Changed"
                                  Margin="0,6,0,0"/>
                        
                        <Label Content="Active Character (auto-detected):" Margin="0,8,0,0"/>
                        <TextBox x:Name="PlayerNameTextBox" Text="" IsReadOnly="True" Background="#383838" Foreground="#4CAF50" FontWeight="Bold"/>
                        
                        <TextBlock Foreground="#AAAAAA" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap">
                            • Character name is automatically detected from the active EverQuest log file.
                            <LineBreak/>
                            • If you're #3 in chain with prefix "D&amp;D", type in game: /say D&amp;D 333 CH
                            <LineBreak/>
                            • If you have an existing macro, append: rotat:3, %t
                        </TextBlock>
                    </StackPanel>
                </TabItem>

                <!-- Tab 2: Features & Alerts -->
                <TabItem Header="⚙️ Features &amp; Alerts">
                    <StackPanel Margin="5">
                        <Label Content="Alerts &amp; Notifications:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <CheckBox x:Name="VisualAlertsCheckBox" Content="Visual Alerts (flash overlay when your turn approaches)" IsChecked="True"/>
                        <CheckBox x:Name="PlaySoundOnChainUpdateCheckBox" Content="Play sound when chain updates (log or cloud)" Checked="PlaySoundOnChainUpdateCheckBox_Changed" Unchecked="PlaySoundOnChainUpdateCheckBox_Changed" Margin="0,2,0,5"/>
                        <CheckBox x:Name="AudioBeepCheckBox" Content="Audio Beep (beep when any CH is cast)" IsChecked="False" Visibility="Collapsed"/>
                        <Button x:Name="ConfigAudioAlertsButton" 
                                Content="🔊 Configure Audio Alerts" 
                                Click="ConfigAudioAlertsButton_Click"
                                Margin="0,5,0,10"
                                HorizontalAlignment="Left"
                                Width="220"
                                Background="#2196F3"/>

                        <Separator Background="#444444" Margin="0,5,0,10"/>

                        <Label Content="Cloud Sync (Web API):" FontWeight="Bold" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Server URL:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="CloudSyncUrlTextBox" Grid.Column="1" Text="https://rotatonator.vercel.app" VerticalAlignment="Center" TextChanged="CloudSyncUrlTextBox_TextChanged"/>
                        </Grid>

                        <Separator Background="#444444" Margin="0,5,0,10"/>

                        <Label Content="DDR Visualization Mode:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <CheckBox x:Name="DDRModeCheckBox" Content="Use DDR Visualization (instead of classic overlay)" IsChecked="False" Checked="DDRModeCheckBox_Changed" Unchecked="DDRModeCheckBox_Changed"/>
                        <CheckBox x:Name="DDRSillyModeCheckBox" Content="DDR Silly Mode (background music and sound effects)" IsChecked="False" Margin="20,0,0,8"/>

                        <WrapPanel Margin="0,5,0,5">
                            <Button x:Name="MuteAudioButton"
                                    Content="🔊 Mute Audio"
                                    Click="MuteAudioButton_Click"
                                    Width="140"
                                    Background="#9C27B0"/>
                            <Button x:Name="ExportDDRScoresButton"
                                    Content="📋 Export Scores"
                                    Click="ExportDDRScoresButton_Click"
                                    Width="140"
                                    Background="#4CAF50"/>
                            <Button x:Name="ResetDDRScoresButton"
                                    Content="🔄 Reset Scores"
                                    Click="ResetDDRScoresButton_Click"
                                    Width="140"
                                    Background="#FF9800"/>
                        </WrapPanel>

                        <!-- Auto-cast hidden but code preserved for future use -->
                        <CheckBox x:Name="AutoCastCheckBox" Content="Auto-Cast (send keypress on your turn)" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="20,5,0,0" Visibility="Collapsed">
                            <Label Content="Hotkey:" Margin="0"/>
                            <TextBox x:Name="HotkeyTextBox" Width="50" Text="1" IsEnabled="{Binding IsChecked, ElementName=AutoCastCheckBox}"/>
                            <Label Content="(key to press for CH spell)" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Timing Configuration -->
            <GroupBox Grid.Row="2" Header="Timing" Foreground="White" Margin="0,0,0,10" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Chain Interval (seconds between heals):" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="DecreaseDelayButton" 
                                Content="−" 
                                Width="40"
                                Height="28"
                                Click="DecreaseDelayButton_Click"
                                Background="#FF9800"/>
                        <TextBlock x:Name="ChainIntervalLabel" 
                                   Text="6s" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   MinWidth="35"
                                   TextAlignment="Center"/>
                        <Button x:Name="IncreaseDelayButton" 
                                Content="+" 
                                Width="40"
                                Height="28"
                                Click="IncreaseDelayButton_Click"
                                Background="#4CAF50"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Control Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                <Button x:Name="StartButton" Content="Start Monitoring" Width="150" Height="34" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="150" Height="34" IsEnabled="False" Click="StopButton_Click" Background="#F44336"/>
            </StackPanel>

            <!-- Status -->
            <GroupBox Grid.Row="4" Header="Status" Foreground="White" Padding="8">
                <TextBlock x:Name="StatusTextBlock" 
                           Foreground="#4CAF50" 
                           Text="Ready to start. Configure settings above and click Start Monitoring."
                           TextWrapping="Wrap"/>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>
